# Server configuration
PORT=5069
LOG_LEVEL=info

# Public URL - Recommended when deployed behind a reverse proxy (e.g. Cloudflare, Nginx, Traefik, Caddy)
# Used to construct canonical callback URLs for Plex OAuth
# PUBLIC_URL=https://your-domain.example

# Database path (persisted to volume in Docker)
DATABASE_PATH=./data/librarydownloadarr.db

# Security settings (recommended for production)
# CORS_ORIGIN=https://library.yourdomain.com
# ADMIN_LOGIN_ENABLED=false

# Transcoding configuration
TRANSCODE_DIR=./transcode
MAX_CONCURRENT_TRANSCODES=2
HARDWARE_ENCODING=auto
TZ=America/New_York
